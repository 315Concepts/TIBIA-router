#! /bin/bash

# Usage: ./verify [production]
# Checks that DNS, certificates and routing work. Run it on the host after ./up.
# Exits non-zero if any check fails.

cd "$(dirname "$0")" || exit 1

# Auto-load the environment, including .env.local
set -a
[ -f .env.local ] && source .env.local
source .env
set +a

# Production mode if the first argument says so
PRODUCTION=false
case "${1,,}" in
  prd|prod|production) PRODUCTION=true ;;
esac

# Staging certificates are untrusted, so curl needs -k to talk to them
CURL_OPTS=(-s --max-time 10)
[ "$PRODUCTION" = false ] && CURL_OPTS+=(-k)

SUBDOMAIN_HOST="${WHOAMI_SUBDOMAIN}.${SERVICE_DOMAIN}"
DASHBOARD_HOST="${TRAEFIK_SUBDOMAIN}.${SERVICE_DOMAIN}"
WHOAMI_PATH="/${WHOAMI_PUBLIC_PATH#/}"

FAILED=0
pass() { echo "PASS  $1"; }
fail() { echo "FAIL  $1"; [ -n "$2" ] && echo "      $2"; FAILED=$((FAILED + 1)); }
skip() { echo "SKIP  $1"; }

echo "Verifying ${SERVICE_DOMAIN} ($([ "$PRODUCTION" = true ] && echo production || echo bringup) mode)"
echo

# 1. Containers are running
if [ -n "$(docker compose -f ./docker-compose-traefik.yaml ps --status running -q 2>/dev/null)" ]; then
  pass "Traefik container is running"
else
  fail "Traefik container is running" "Start it with ./up"
fi

if [ "$PRODUCTION" = false ]; then
  if [ "$(docker compose -f ./docker-compose-debug.yaml ps --status running -q 2>/dev/null | wc -l)" -ge 2 ]; then
    pass "Both whoami canaries are running"
  else
    fail "Both whoami canaries are running" "Start them with ./up (without 'production')"
  fi
fi

# 2. HTTP redirects to HTTPS
CODE=$(curl "${CURL_OPTS[@]}" -o /dev/null -w '%{http_code} %{redirect_url}' "http://${SERVICE_DOMAIN}")
case "$CODE" in
  301\ https://*) pass "http://${SERVICE_DOMAIN} redirects to HTTPS (301)" ;;
  *) fail "http://${SERVICE_DOMAIN} redirects to HTTPS (301)" "Got: ${CODE:-no response}" ;;
esac

# 3 + 4. Canary routes (bringup only)
if [ "$PRODUCTION" = false ]; then
  BODY=$(curl "${CURL_OPTS[@]}" "https://${SUBDOMAIN_HOST}")
  if echo "$BODY" | grep -qi "^Host: ${SUBDOMAIN_HOST}"; then
    pass "Subdomain route: https://${SUBDOMAIN_HOST}"
  else
    fail "Subdomain route: https://${SUBDOMAIN_HOST}" "Expected whoami output with 'Host: ${SUBDOMAIN_HOST}'"
  fi

  [[ "$WHOAMI_PUBLIC_PATH" != /* ]] && echo "NOTE  WHOAMI_PUBLIC_PATH has no leading slash; the router rule needs one"
  BODY=$(curl "${CURL_OPTS[@]}" "https://${SERVICE_DOMAIN}${WHOAMI_PATH}")
  if echo "$BODY" | grep -q "^GET / HTTP"; then
    pass "Path route: https://${SERVICE_DOMAIN}${WHOAMI_PATH} (prefix stripped)"
  else
    fail "Path route: https://${SERVICE_DOMAIN}${WHOAMI_PATH} (prefix stripped)" "Expected whoami output with request line 'GET / HTTP/1.1'"
  fi
else
  skip "Canary routes (not started in production - check a service of your own)"
fi

# 5. Certificate issuer matches the mode
# Checked on the dashboard host, since it is the one router that exists in every mode.
# (In production nothing is routed on the apex domain, so Traefik would serve its default certificate there.)
if command -v openssl >/dev/null; then
  ISSUER=$(echo | openssl s_client -connect "${DASHBOARD_HOST}:${PRIVATE_HTTPS_PORT}" -servername "${DASHBOARD_HOST}" 2>/dev/null | openssl x509 -noout -issuer 2>/dev/null)
  if [ -z "$ISSUER" ]; then
    fail "Certificate issuer" "Could not read a certificate from ${DASHBOARD_HOST}:${PRIVATE_HTTPS_PORT}"
  elif echo "$ISSUER" | grep -qi "TRAEFIK DEFAULT CERT"; then
    fail "Certificate issuer" "Traefik is serving its self-signed default certificate - issuance has not completed. Check the logs: docker compose -f ./docker-compose-traefik.yaml logs"
  elif [ "$PRODUCTION" = true ] && ! echo "$ISSUER" | grep -qi "staging"; then
    pass "Certificate is from the production issuer (${ISSUER#issuer=})"
  elif [ "$PRODUCTION" = false ] && echo "$ISSUER" | grep -qi "staging"; then
    pass "Certificate is from the staging issuer, as expected"
  else
    fail "Certificate issuer" "Got: ${ISSUER} - if this is wrong, try ./down && ./clean and start again"
  fi
else
  skip "Certificate issuer (openssl not installed)"
fi

# 6. Dashboard answers on the private port
CODE=$(curl "${CURL_OPTS[@]}" -o /dev/null -w '%{http_code}' "https://${DASHBOARD_HOST}:${PRIVATE_HTTPS_PORT}/dashboard/")
if [ "$CODE" = "200" ]; then
  pass "Dashboard: https://${DASHBOARD_HOST}:${PRIVATE_HTTPS_PORT}/dashboard/"
else
  fail "Dashboard: https://${DASHBOARD_HOST}:${PRIVATE_HTTPS_PORT}/dashboard/" "Got HTTP ${CODE}"
fi

echo
if [ "$FAILED" -eq 0 ]; then
  echo "All checks passed."
else
  echo "${FAILED} check(s) failed."
  exit 1
fi
