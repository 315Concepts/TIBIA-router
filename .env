
###############
### REQUIRED VARIABLES
SERVICE_DOMAIN=${SERVICE_DOMAIN:?Must configure a base domain that you have DNS control over}
ACME_CERTIFICATE_EMAIL=${ACME_CERTIFICATE_EMAIL:?Set ACME_CERTIFICATE_EMAIL for Lets Encrypt}

###############
### STACK VERSIONS
TRAEFIK_VERSION=${TRAEFIK_VERSION:-3.7}

###############
### TRAEFIK
PRIVATE_HTTPS_PORT=${PRIVATE_HTTPS_PORT:-8443}
ACME_DEFAULT_RESOLVER=${ACME_DEFAULT_RESOLVER:-stg}
# SUBDOMAINS
TRAEFIK_SUBDOMAIN=${TRAEFIK_SUBDOMAIN:-traefik}
WHOAMI_SUBDOMAIN=${WHOAMI_SUBDOMAIN:-whosub} # Enabled by default for bringup support - remove after domain validation
WHOAMI_PUBLIC_PATH=${WHOAMI_PUBLIC_PATH:-/whopath} # Enabled by default for bringup support - remove after domain validation